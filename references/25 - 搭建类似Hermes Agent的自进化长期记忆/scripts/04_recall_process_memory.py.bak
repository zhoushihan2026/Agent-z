"""进行中会话的过程记忆召回。

过程记忆是"当前这个会话自己的临时状态"：失败工具、待确认点、刚修正过的做法。
所以召回范围是当前会话攒下的过程笔记，不是别的历史会话的记忆。

主体三段：
1. 文档读取：读取当前事件 + 当前会话的过程记忆；
2. 模型生成关键词后匹配：模型看当前事件产出 query_keywords，代码用它匹配笔记；
3. 文档写入：保存 process_context.json。
"""

from __future__ import annotations

import asyncio
import json
from typing import Any

from _common import (
    MATERIALS_DIR,
    MEMORY_DIR,
    configure_model,
    keyword_score,
    print_json,
    read_json,
    run_model_request_with_retry,
    write_json,
)
from agently import Agently

CURRENT_EVENT_PATH = MATERIALS_DIR / "current_process_event.json"
CURRENT_PROCESS_MEMORY_PATH = MATERIALS_DIR / "current_session_process_memory.json"
PROCESS_CONTEXT_PATH = MEMORY_DIR / "process_context.json"


async def generate_process_keywords(current_event: dict[str, Any]) -> dict[str, Any]:
    async def request() -> dict[str, Any]:
        agent = Agently.create_agent()
        result = await (
            agent.info({"当前运行时事件": current_event})
            .input("为进行中会话的过程记忆召回生成检索关键词。")
            .instruct(
                [
                    "过程记忆关注当前执行刚发生的失败、待确认、修正动作。",
                    "query_keywords 由你生成，后续代码只按这些关键词匹配。",
                    "不要生成长期偏好召回计划；这里不是新会话启动。",
                ]
            )
            .output(
                {
                    "query_keywords": [("str",)],
                    "needed_process_state": [("str",)],
                    "reason": ("str",),
                }
            )
            .async_start()
        )
        if not isinstance(result, dict) or not isinstance(
            result.get("query_keywords"), list
        ):
            raise RuntimeError("transient_model_parse_failed: invalid process query")
        return result

    return await run_model_request_with_retry(request)


def top_process_matches(
    process_notes: list[dict[str, Any]], generated_keywords: list[str]
) -> list[dict[str, Any]]:
    ranked = sorted(
        process_notes,
        key=lambda note: keyword_score(
            json.dumps(note, ensure_ascii=False), generated_keywords
        ),
        reverse=True,
    )
    return [
        note
        for note in ranked[:5]
        if keyword_score(json.dumps(note, ensure_ascii=False), generated_keywords) > 0
    ]


async def main() -> None:
    configure_model()

    # 1. 文档读取：当前触发事件 + 当前会话到此刻的过程笔记。
    current_event = read_json(CURRENT_EVENT_PATH)
    current_session = read_json(CURRENT_PROCESS_MEMORY_PATH)
    process_notes = list(current_session.get("process_memory", []))

    # 2. 模型生成关键词后匹配（匹配对象只有当前会话的过程笔记）。
    process_query = await generate_process_keywords(current_event)
    generated_keywords = [str(item) for item in process_query["query_keywords"]]
    selected_process_memory = top_process_matches(process_notes, generated_keywords)

    # 3. 文档写入
    process_context = {
        "current_event": current_event,
        "process_query": process_query,
        "selected_process_memory": selected_process_memory,
    }
    write_json(PROCESS_CONTEXT_PATH, process_context)
    print_json(
        {
            "stage": "process_memory_recall",
            "output": str(PROCESS_CONTEXT_PATH),
            "keyword_count": len(generated_keywords),
            "selected_count": len(selected_process_memory),
        }
    )


if __name__ == "__main__":
    asyncio.run(main())
